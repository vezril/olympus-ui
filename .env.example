# Runtime (server-side) env only — the chart sets these.
# NEXT_PUBLIC_* is inlined at BUILD time and must never be used for upstreams.

# Per-console health target. Defaults to GET / on the in-cluster Service
# (http://<service>.<namespace>.svc.cluster.local/), which is what the k8s
# readiness probe already uses. Override to point at a deeper endpoint.
# OLYMPUS_HEALTH_URL_DIONYSUS=http://dionysus-planner.dionysus.svc.cluster.local/api/dionysus/health
# OLYMPUS_HEALTH_URL_HERMES=http://hermes-ui.hermes.svc.cluster.local/api/hermes/health
# OLYMPUS_HEALTH_URL_APOLLO=
# OLYMPUS_HEALTH_URL_ARTEMIS=
# OLYMPUS_HEALTH_URL_DEMETER=

# Per-probe timeout. Default 3000.
# OLYMPUS_HEALTH_TIMEOUT_MS=3000
