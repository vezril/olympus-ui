# Runtime (server-side) env only — the chart sets these.
# NEXT_PUBLIC_* is inlined at BUILD time and must never be used for upstreams.

# olympus-service owns the console registry and the health fan-out.
# OLYMPUS_SERVICE_URL=http://olympus-service.olympus.svc.cluster.local

# How long the BFF waits on the service before giving up and saying so.
# OLYMPUS_SERVICE_TIMEOUT_MS=4000
